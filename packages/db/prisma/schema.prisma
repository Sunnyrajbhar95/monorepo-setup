// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}

enum Role {
  User
  Admin
}

enum ExpenseType {
  Food
  Travel
  Shopping
  Bills
  Entertainment
  Healthcare
  Education
  Rent
  Salary
  Investment
  Fuel
  Insurance
  EMI
  Subscription
  Gift
  Personal_Care
  Office
  Other
}

enum PaymentMethod {
  UPI
  Credit_Card
  Debit_Card
  Net_Banking
  Cash
  Gift_Card
  Other
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String               @unique
  password             String
  profilePicture       String?
  isVerified           Boolean              @default(false)
  otp                  String?
  otpExpireTime        DateTime?
  role                 Role                 @default(User)
  refreshToken         String?
  expenses             Expense[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now())
  bills                Bill[]
  billParticipents     BillParticipent[]
  billPaymentHistories BillPaymentHistory[]
}

model Expense {
  id                 String        @id @default(cuid())
  user               User          @relation(fields: [userId], references: [id])
  userId             String
  amount             Int
  expenseType        ExpenseType
  otherExpenseType   String?
  notes              String?
  paymentMethod      PaymentMethod
  otherPaymentMethod String?
  reciept            String?
  date               DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now())
}

enum BillStatus {
  ACTIVE
  SETTLED
  PARTIALLY_PAID
}

enum BillParticipentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
}

model Bill {
  id           String            @id @default(cuid())
  user         User              @relation(fields: [userId], references: [id])
  userId       String
  title        String
  description  String?
  amount       Int
  status       BillStatus        @default(ACTIVE)
  reciept      String?
  spliteType   String
  billDate     DateTime          @default(now())
  participents BillParticipent[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now())
}

model BillParticipent {
  id               String                @id @default(cuid())
  bill             Bill                  @relation(fields: [billId], references: [id])
  billId           String
  user             User                  @relation(fields: [userId], references: [id])
  userId           String
  name             String
  email            String
  mobile           String
  owedAmount       Int
  paidAmount       Int                   @default(0)
  status           BillParticipentStatus @default(PENDING)
  paymentHistories BillPaymentHistory[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now())
}

model BillPaymentHistory {
  id              String          @id @default(cuid())
  user            User            @relation(fields: [userId], references: [id])
  userId          String
  billParticipent BillParticipent @relation(fields: [participentId], references: [id])
  participentId   String
  amount          Int
  paymentDate     DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now())
}
